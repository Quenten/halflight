# Copy to .env and adjust. .env is git-ignored.

# Postgres (matches docker-compose.yml). psycopg3 driver.
DATABASE_URL=postgresql+psycopg://halflight:halflight@127.0.0.1:5432/halflight

# llama.cpp servers on the host (see README for startup commands).
LLAMA_CHAT_URL=http://127.0.0.1:8080
LLAMA_EMBED_URL=http://127.0.0.1:8081
